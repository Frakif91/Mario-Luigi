[sub_resource type="GDScript" id="GDScript_6aq3o"]
resource_name = "auto_audio"
script/source = "extends AnimationPlayer

@onready var audio_player : AudioStreamPlayer = AudioStreamPlayer.new()

# Called when the node enters the scene tree for the first time.
func _ready():
	add_child(audio_player)

var ratings_sfx = {
	\"Ok\" : preload(\"res://Assets/Sound/SE_BTL_GOOD.wav\"),
	\"Good\" : preload(\"res://Assets/Sound/SE_BTL_GOOD.wav\"),
	\"Great\" : preload(\"res://Assets/Sound/SE_BTL_GREAT.wav\"),
	\"Excellent\" : preload(\"res://Assets/Sound/SE_BTL_EXCELENT.wav\")
}

func _on_current_animation_changed(r_name):
	if ratings_sfx.has(r_name):
		audio_player.stream = ratings_sfx[r_name]
		audio_player.play()
"

